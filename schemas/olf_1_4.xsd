<?xml version="1.0" encoding="UTF-8"?>
<!--
  OLF - Open Lesdoelen Formaat
  XML Schema, versie 1.4

  OLF 1.4 (01/09/2026) bouwt verder op OLF 1.2 (laatste gedocumenteerde
  specificatie) en OLF 1.3 (schema-uitbreiding).

  Breuken met oudere versies:
  - LearningObjectiveIdentifier is verplicht en uniek binnen een Method;
  - codetype="smartschool_uuid" (1.3) is geschrapt.

  Het schema is bewust XSD 1.0 zonder targetNamespace, zodat bestaande
  implementaties zonder aanpassing blijven werken.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           attributeFormDefault="unqualified"
           elementFormDefault="qualified"
           version="1.4">

	<xs:annotation>
		<xs:documentation xml:lang="nl">
			Open Lesdoelen Formaat (OLF) 1.4 - gemeenschappelijke standaard voor het
			uitwisselen van lesdoelen, gekoppeld aan leerplandoelen en
			minimumdoelen/eindtermen, tussen aanbieders van lesdoelen en LMS-platformen.
		</xs:documentation>
	</xs:annotation>

	<!-- =========================================================== -->
	<!-- Root element                                                 -->
	<!-- =========================================================== -->

	<xs:element name="OLFMessage" type="OLFMessageType">
		<xs:annotation>
			<xs:documentation xml:lang="nl">Root element van een OLF-bericht.</xs:documentation>
		</xs:annotation>
	</xs:element>

	<!-- =========================================================== -->
	<!-- Basistypes                                                   -->
	<!-- =========================================================== -->

	<xs:simpleType name="NonEmptyStringType">
		<xs:annotation>
			<xs:documentation xml:lang="nl">Tekst die minstens een niet-witruimte karakter bevat.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="[\s\S]*\S[\s\S]*"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="EmailType">
		<xs:restriction base="xs:string">
			<xs:pattern value="[A-Za-z0-9!#-'\*\+\-/=\?\^_`\{-~]+(\.[A-Za-z0-9!#-'\*\+\-/=\?\^_`\{-~]+)*@[A-Za-z0-9\-]+(\.[A-Za-z0-9\-]+)+"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="SentDateTimeType">
		<xs:annotation>
			<xs:documentation xml:lang="nl">Formaat JJJJ-MM-DDTHH:MM, lokale Belgische tijd.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="OLFVersionType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="1"/>
			<xs:enumeration value="1.0"/>
			<xs:enumeration value="1.1"/>
			<xs:enumeration value="1.2"/>
			<xs:enumeration value="1.3"/>
			<xs:enumeration value="1.4"/>
		</xs:restriction>
	</xs:simpleType>

	<!-- =========================================================== -->
	<!-- Codelijsten                                                  -->
	<!-- =========================================================== -->

	<xs:simpleType name="TargetAudienceCodeType">
		<xs:annotation>
			<xs:documentation xml:lang="nl">Codelijst 1: indeling onderwijs.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<!-- Kleuteronderwijs -->
			<xs:enumeration value="KO-J0"/>
			<xs:enumeration value="KO-J1"/>
			<xs:enumeration value="KO-J2"/>
			<xs:enumeration value="KO-J3"/>
			<!-- Lager onderwijs -->
			<xs:enumeration value="LO-J1"/>
			<xs:enumeration value="LO-J2"/>
			<xs:enumeration value="LO-J3"/>
			<xs:enumeration value="LO-J4"/>
			<xs:enumeration value="LO-J5"/>
			<xs:enumeration value="LO-J6"/>
			<!-- Secundair onderwijs: jaar -->
			<xs:enumeration value="SO-J1"/>
			<xs:enumeration value="SO-J2"/>
			<xs:enumeration value="SO-J3"/>
			<xs:enumeration value="SO-J4"/>
			<xs:enumeration value="SO-J5"/>
			<xs:enumeration value="SO-J6"/>
			<!-- Secundair onderwijs: graad -->
			<xs:enumeration value="SO-G1"/>
			<xs:enumeration value="SO-G2"/>
			<xs:enumeration value="SO-G3"/>
			<!-- Secundair onderwijs: doelgroep -->
			<xs:enumeration value="SO-ASTR"/>
			<xs:enumeration value="SO-BSTR"/>
			<xs:enumeration value="SO-ASO"/>
			<xs:enumeration value="SO-BSO"/>
			<xs:enumeration value="SO-TSO"/>
			<xs:enumeration value="SO-KSO"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="CategoryTypeCodeType">
		<xs:annotation>
			<xs:documentation xml:lang="nl">Codelijst 2: categorisering lesdoelen.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="CHAPTER"/>
			<xs:enumeration value="LEARNINGAREA"/>
			<xs:enumeration value="LEARNINGDOMAIN"/>
			<xs:enumeration value="LESSONNUMBER"/>
			<xs:enumeration value="LESSON"/>
			<xs:enumeration value="THEME"/>
			<xs:enumeration value="BLOCK"/>
			<xs:enumeration value="OBJECTIVEPRIORITY"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="CurriculumTypeCodeType">
		<xs:annotation>
			<xs:documentation xml:lang="nl">
				Codelijst 3: type leerplan / doelenpicker. VSKO blijft behouden voor
				achterwaartse compatibiliteit.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<!-- Codes uit OLF 1.0 - 1.3 -->
			<xs:enumeration value="GO"/>
			<xs:enumeration value="OVSG"/>
			<xs:enumeration value="VVKBAO"/>
			<xs:enumeration value="VVKSO"/>
			<xs:enumeration value="POV"/>
			<xs:enumeration value="VSKO"/>
			<!-- Nieuw in OLF 1.4 -->
			<xs:enumeration value="GO-NAV-BAO"/>
			<xs:enumeration value="GO-NAV-SO"/>
			<xs:enumeration value="OPSTAP"/>
			<xs:enumeration value="LLINKID"/>
			<xs:enumeration value="LEERLOKAAL-BAO"/>
			<xs:enumeration value="LEERLOKAAL-SO"/>
			<xs:enumeration value="ROOMSKATH-BAO"/>
			<xs:enumeration value="ROOMSKATH-SO"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="CodeTypeCodeType">
		<xs:annotation>
			<xs:documentation xml:lang="nl">
				Aard van de waarde in LearningObjectiveCode: full (volledige code of
				prefix, standaard), short (korte code), uuid (id van het doel zoals
				gepubliceerd door de koepel of doelenpicker). De waarde smartschool_uuid
				uit OLF 1.3 is in 1.4 geschrapt.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="short"/>
			<xs:enumeration value="full"/>
			<xs:enumeration value="uuid"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="QualificationCodeTypeCodeType">
		<xs:annotation>
			<xs:documentation xml:lang="nl">
				Aard van de waarde in Qualification: code (naam/code van het
				minimumdoel of de eindterm, bv. "WT 1.11") of uuid. Een aanbieder
				mag een van beide of beide meesturen.
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="code"/>
			<xs:enumeration value="uuid"/>
		</xs:restriction>
	</xs:simpleType>

	<!-- =========================================================== -->
	<!-- Structuur                                                    -->
	<!-- =========================================================== -->

	<xs:complexType name="OLFMessageType">
		<xs:sequence>
			<xs:element name="Header" type="HeaderType"/>
			<xs:element name="Publishers" type="PublishersType"/>
		</xs:sequence>
		<xs:attribute name="version" type="OLFVersionType" use="required"/>
	</xs:complexType>

	<xs:complexType name="HeaderType">
		<xs:all>
			<xs:element name="Sender" type="NonEmptyStringType"/>
			<xs:element name="SentDateTime" type="SentDateTimeType"/>
		</xs:all>
	</xs:complexType>

	<xs:complexType name="PublishersType">
		<xs:sequence>
			<xs:element name="Publisher" type="PublisherType" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="PublisherType">
		<xs:all>
			<xs:element name="PublisherIdentifier" type="NonEmptyStringType">
				<xs:annotation>
					<xs:documentation xml:lang="nl">Unieke identifier van de uitgever, bij voorkeur het ISNI-nummer.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PublisherName" type="NonEmptyStringType"/>
			<xs:element name="PublisherEmail" type="EmailType"/>
			<xs:element name="Methods" type="MethodsType"/>
		</xs:all>
	</xs:complexType>

	<xs:complexType name="MethodsType">
		<xs:sequence>
			<xs:element name="Method" type="MethodType" maxOccurs="unbounded">
				<xs:key name="UniqueLearningObjectiveIdentifier">
					<xs:annotation>
						<xs:documentation xml:lang="nl">LearningObjectiveIdentifier is uniek binnen een Method.</xs:documentation>
					</xs:annotation>
					<xs:selector xpath="LearningObjectives/LearningObjective"/>
					<xs:field xpath="LearningObjectiveIdentifier"/>
				</xs:key>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="MethodType">
		<xs:all>
			<xs:element name="MethodIdentifier" type="NonEmptyStringType"/>
			<xs:element name="MethodName" type="xs:string" minOccurs="0"/>
			<xs:element name="TargetAudiences" type="TargetAudiencesType" minOccurs="0"/>
			<xs:element name="LearningObjectives" type="LearningObjectivesType"/>
		</xs:all>
	</xs:complexType>

	<xs:complexType name="TargetAudiencesType">
		<xs:sequence>
			<xs:element name="TargetAudience" type="TargetAudienceCodeType" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="LearningObjectivesType">
		<xs:sequence>
			<xs:element name="LearningObjective" type="LearningObjectiveType" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="LearningObjectiveType">
		<xs:all>
			<xs:element name="LearningObjectiveIdentifier" type="NonEmptyStringType">
				<xs:annotation>
					<xs:documentation xml:lang="nl">Verplicht sinds 1.4. Aanbiederspecifieke identifier, uniek binnen de Method.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LearningObjectiveDescription" type="xs:string" minOccurs="0"/>
			<xs:element name="LearningObjectiveCategories" type="LearningObjectiveCategoriesType" minOccurs="0"/>
			<xs:element name="LearningObjectiveCodes" type="LearningObjectiveCodesType" minOccurs="0"/>
			<xs:element name="LearningObjectiveUri" type="xs:anyURI" minOccurs="0">
				<xs:annotation>
					<xs:documentation xml:lang="nl">Sinds 1.3: permanente link naar het lesdoel bij de aanbieder.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Qualifications" type="QualificationsType" minOccurs="0"/>
		</xs:all>
	</xs:complexType>

	<xs:complexType name="LearningObjectiveCategoriesType">
		<xs:sequence>
			<xs:element name="LearningObjectiveCategory" type="LearningObjectiveCategoryType" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="LearningObjectiveCategoryType">
		<xs:simpleContent>
			<xs:extension base="xs:string">
				<xs:attribute name="type" type="CategoryTypeCodeType" use="required"/>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>

	<xs:complexType name="LearningObjectiveCodesType">
		<xs:sequence>
			<xs:element name="LearningObjectiveCode" type="LearningObjectiveCodeType" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="LearningObjectiveCodeType">
		<xs:annotation>
			<xs:documentation xml:lang="nl">Koppeling van het lesdoel aan een leerplandoel.</xs:documentation>
		</xs:annotation>
		<xs:simpleContent>
			<xs:extension base="NonEmptyStringType">
				<xs:attribute name="type" type="CurriculumTypeCodeType" use="required"/>
				<xs:attribute name="codetype" type="CodeTypeCodeType" default="full"/>
				<xs:attribute name="version" type="NonEmptyStringType">
					<xs:annotation>
						<xs:documentation xml:lang="nl">Versie van het leerplan waartoe het doel behoort (bv. de curriculum-id bij Zill, de leerplanversie bij LeerLokaal).</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>

	<xs:complexType name="QualificationsType">
		<xs:sequence>
			<xs:element name="Qualification" type="QualificationType" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="QualificationType">
		<xs:annotation>
			<xs:documentation xml:lang="nl">Koppeling van het lesdoel aan een minimumdoel of eindterm.</xs:documentation>
		</xs:annotation>
		<xs:simpleContent>
			<xs:extension base="NonEmptyStringType">
				<xs:attribute name="codetype" type="QualificationCodeTypeCodeType"/>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>

</xs:schema>
